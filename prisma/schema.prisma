generator client {
  provider = "prisma-client-js"
  // Generate types for better TypeScript support
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  email        String   @unique
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@map("admins")
}

model Category {
  id          Int      @id @default(autoincrement())
  title       String   @unique
  slug        String   @unique // URL-friendly version of title
  imageUrl    String? // Category image
  description String? // Category description
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0) // For custom ordering
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  works       Work[]
  
  @@map("categories")
}

model Work {
  id               Int      @id @default(autoincrement())
  title            String
  slug             String   @unique // URL-friendly version of title
  description      String? // Work description
  mainImageUrl     String // Main work image
  additionalImages String? // Additional images (JSON string)
  videoLink        String? // Video link (optional)
  tags             String? // Tags for better categorization (JSON string)
  isPublished      Boolean  @default(true)
  isFeatured       Boolean  @default(false) // For highlighting important works
  viewCount        Int      @default(0) // Track popularity
  sortOrder        Int      @default(0) // For custom ordering
  categoryId       Int      // Category foreign key
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  // Relations
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  @@map("works")
}

model Image {
  id          String   @id @default(cuid())
  url         String
  title       String
  description String? // Image description
  altText     String? // Alt text for accessibility
  category    String? // Category (e.g., design, photography, code)
  tags        String? // Tags for better organization (JSON string)
  fileSize    Int?     // File size in bytes
  mimeType    String? // MIME type
  width       Int?     // Image width in pixels
  height      Int?     // Image height in pixels
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("images")
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String
  isActive        Boolean   @default(true)
  emailVerified   Boolean   @default(false)
  lastLoginAt     DateTime?
  shoppingCart    String?   // Shopping cart items (JSON string)
  favoriteProducts String?  // Favorite products (JSON string)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@map("users")
}

model Text {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique // URL-friendly version of title
  content     String
  excerpt     String? // Text summary
  category    String? // Category (e.g., blog, project, about)
  tags        String? // Tags for better categorization (JSON string)
  published   Boolean  @default(false) // Whether published or not
  publishedAt DateTime? // When it was published
  viewCount   Int      @default(0) // Track popularity
  sortOrder   Int      @default(0) // For custom ordering
  metaTitle   String? // SEO meta title
  metaDescription String? // SEO meta description
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("texts")
} 